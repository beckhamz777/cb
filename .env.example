# ==============================================================================
# Pesapal v3 Backend API Environment Configuration
# ==============================================================================

# Pesapal Environment Base URL ('https://pay.pesapal.com/v3' for Live / Sandbox)
PESAPAL_BASE_URL=https://pay.pesapal.com/v3

# OAuth 2.0 Client Credentials (from Pesapal Merchant Dashboard)
PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key_here
PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret_here

# Registered Instant Payment Notification (IPN) Webhook ID
PESAPAL_IPN_ID=your_pesapal_ipn_id_here

# Public Application Domains for Webhook and Return Callbacks
PESAPAL_CALLBACK_URL=https://checkbook.co.ug/#/payment/callback
PESAPAL_IPN_URL=https://checkbook.co.ug/api/payments/webhook/pesapal

# Frontend Client Public Environment Variables
VITE_PESAPAL_CONSUMER_KEY=your_pesapal_consumer_key_here
VITE_PESAPAL_CONSUMER_SECRET=your_pesapal_consumer_secret_here
VITE_PESAPAL_IPN_ID=your_pesapal_ipn_id_here

# GitHub Personal Access Token (fine-grained, read-only: Contents + Metadata)
# Used to fetch latest release info from the private oworinaweviolet1968/CHECKBOOK repo
# Generate at: https://github.com/settings/tokens?type=beta
VITE_GITHUB_TOKEN=your_github_pat_here
